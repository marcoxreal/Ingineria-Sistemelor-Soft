<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="org.example.controller.HomeController"
            stylesheets="@styles.css">

    <top>
        <HBox spacing="10" alignment="CENTER_LEFT" styleClass="top-bar">
            <Label text="Tuneboxd" styleClass="brand-label"/>
            <TextField fx:id="searchBar" promptText="Search albums or artists" HBox.hgrow="ALWAYS"/>
            <Button text="Search" onAction="#handleSearch" styleClass="primary-button"/>
            <Region prefWidth="18"/>
            <TextField fx:id="userSearchBar" promptText="Search users" prefWidth="180"/>
            <Button text="Find User" onAction="#handleUserSearch" styleClass="secondary-button"/>
            <Button text="My Profile" onAction="#handleMyProfile"/>
        </HBox>
    </top>

    <center>
        <ScrollPane fitToWidth="true" styleClass="home-scroll">
            <VBox spacing="20" alignment="TOP_LEFT" styleClass="home-content">
                <VBox fx:id="recentBigReleasesSection" spacing="10" visible="false" managed="false" styleClass="home-section">
                    <Label fx:id="recentBigReleasesTitle" text="Recent Big Releases" styleClass="section-title"/>
                    <TilePane fx:id="recentBigReleasesGrid"
                              hgap="15"
                              vgap="15"
                              tileAlignment="TOP_LEFT"
                              prefColumns="5">
                        <padding>
                            <Insets top="8" right="0" bottom="0" left="0"/>
                        </padding>
                    </TilePane>
                </VBox>

                <VBox fx:id="bigDebutAlbumsSection" spacing="10" visible="false" managed="false" styleClass="home-section">
                    <Label fx:id="bigDebutAlbumsTitle" text="Big Debut Albums" styleClass="section-title"/>
                    <TilePane fx:id="bigDebutAlbumsGrid"
                              hgap="15"
                              vgap="15"
                              tileAlignment="TOP_LEFT"
                              prefColumns="5">
                        <padding>
                            <Insets top="8" right="0" bottom="0" left="0"/>
                        </padding>
                    </TilePane>
                </VBox>

                <VBox fx:id="developersPickSection" spacing="10" visible="false" managed="false" styleClass="home-section">
                    <Label fx:id="developersPickTitle" text="Developer's Pick" styleClass="section-title"/>
                    <TilePane fx:id="developersPickGrid"
                              hgap="15"
                              vgap="15"
                              tileAlignment="TOP_LEFT"
                              prefColumns="5">
                        <padding>
                            <Insets top="8" right="0" bottom="0" left="0"/>
                        </padding>
                    </TilePane>
                </VBox>

                <TilePane fx:id="albumGrid"
                          hgap="15"
                          vgap="15"
                          tileAlignment="TOP_LEFT"
                          prefColumns="5">
                    <padding>
                        <Insets top="0" right="0" bottom="0" left="0"/>
                    </padding>
                </TilePane>
            </VBox>
        </ScrollPane>
    </center>

</BorderPane>
