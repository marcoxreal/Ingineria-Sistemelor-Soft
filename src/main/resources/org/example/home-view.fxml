<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="org.example.controller.HomeController"
            stylesheets="@styles.css">

    <top>
        <HBox spacing="10" alignment="CENTER_LEFT" styleClass="top-bar">
            <TextField fx:id="searchBar" promptText="Search albums or artists"/>
            <Button text="Search" onAction="#handleSearch"/>
            <TextField fx:id="userSearchBar" promptText="Search users"/>
            <Button text="Find User" onAction="#handleUserSearch"/>
            <Button text="My Profile" onAction="#handleMyProfile"/>
        </HBox>
    </top>

    <center>
        <ScrollPane fitToWidth="true">
            <VBox spacing="20" alignment="TOP_LEFT" styleClass="home-content">
                <!-- Recent Big Releases Section -->
                <VBox fx:id="recentBigReleasesSection" spacing="10" visible="false" managed="false">
                    <Label fx:id="recentBigReleasesTitle" text="Recent Big Releases" styleClass="section-title"/>
                    <TilePane fx:id="recentBigReleasesGrid"
                              hgap="15"
                              vgap="15"
                              prefColumns="5">
                        <padding>
                            <Insets top="10" right="20" bottom="10" left="20"/>
                        </padding>
                    </TilePane>
                </VBox>

                <!-- Big Debut Albums Section -->
                <VBox fx:id="bigDebutAlbumsSection" spacing="10" visible="false" managed="false">
                    <Label fx:id="bigDebutAlbumsTitle" text="Big Debut Albums" styleClass="section-title"/>
                    <TilePane fx:id="bigDebutAlbumsGrid"
                              hgap="15"
                              vgap="15"
                              prefColumns="5">
                        <padding>
                            <Insets top="10" right="20" bottom="10" left="20"/>
                        </padding>
                    </TilePane>
                </VBox>

                <!-- Developer's Pick Section -->
                <VBox fx:id="developersPickSection" spacing="10" visible="false" managed="false">
                    <Label fx:id="developersPickTitle" text="Developer's Pick" styleClass="section-title"/>
                    <TilePane fx:id="developersPickGrid"
                              hgap="15"
                              vgap="15"
                              prefColumns="5">
                        <padding>
                            <Insets top="10" right="20" bottom="10" left="20"/>
                        </padding>
                    </TilePane>
                </VBox>

                <!-- Search Results Grid (original albumGrid) -->
                <TilePane fx:id="albumGrid"
                          hgap="15"
                          vgap="15"
                          prefColumns="5">
                    <padding>
                        <Insets top="20" right="20" bottom="20" left="20"/>
                    </padding>
                </TilePane>
            </VBox>
        </ScrollPane>
    </center>

</BorderPane>
