<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="org.example.controller.AlbumController"
            stylesheets="@styles.css">

    <!-- TOP BAR -->
    <top>
        <HBox spacing="10" alignment="CENTER_LEFT" styleClass="top-bar">
            <Button text="Back" onAction="#handleBack"/>
            <TextField fx:id="searchBar" promptText="Search albums or artists"/>
            <Button text="Search" onAction="#handleSearch"/>
        </HBox>
    </top>

    <!-- MAIN CONTENT -->
    <center>
        <VBox alignment="CENTER" spacing="20" styleClass="album-container">

            <ImageView fx:id="coverImage"
                       fitWidth="220"
                       fitHeight="220"
                       preserveRatio="true"/>

            <Label fx:id="titleLabel" styleClass="title-label"/>
            <Label fx:id="artistLabel" styleClass="artist-label"/>
            <Label fx:id="ratingLabel" styleClass="rating-label"/>
            <Label fx:id="listenedLabel" styleClass="muted-text"/>

            <HBox alignment="CENTER" spacing="10">
                <Button text="Mark Listened" onAction="#handleMarkListened"/>
                <Button text="Log Album" onAction="#handleLogAlbum"/>
            </HBox>

            <VBox spacing="8" styleClass="review-box">
                <Label text="Rate and review" styleClass="section-title-label"/>
                <HBox alignment="CENTER_LEFT" spacing="8">
                    <Label text="Your Rating:"/>
                    <ImageView fx:id="star1" onMouseClicked="#handleStarClick" styleClass="star-icon"/>
                    <ImageView fx:id="star2" onMouseClicked="#handleStarClick" styleClass="star-icon"/>
                    <ImageView fx:id="star3" onMouseClicked="#handleStarClick" styleClass="star-icon"/>
                    <ImageView fx:id="star4" onMouseClicked="#handleStarClick" styleClass="star-icon"/>
                    <ImageView fx:id="star5" onMouseClicked="#handleStarClick" styleClass="star-icon"/>
                    <Button text="Submit Review" onAction="#handleSubmitReview"/>
                </HBox>
                <TextArea fx:id="reviewTextArea"
                          promptText="Write a review"
                          prefRowCount="3"
                          wrapText="true"/>
            </VBox>

            <VBox spacing="8" styleClass="review-box">
                <Label text="Recent reviews" styleClass="section-title-label"/>
                <ListView fx:id="reviewsList" prefHeight="160"/>
            </VBox>

        </VBox>
    </center>

</BorderPane>
