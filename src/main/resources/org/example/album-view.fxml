<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import java.util.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<?import javafx.scene.image.ImageView?>
<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="org.example.controller.AlbumController"
            stylesheets="@styles.css">

    <!-- TOP BAR -->
    <top>
        <HBox spacing="10" alignment="CENTER_LEFT" styleClass="top-bar">
            <Button text="Back" onAction="#handleBack"/>
            <TextField fx:id="searchBar" promptText="Search albums or artists"/>
            <Button text="Search" onAction="#handleSearch"/>
        </HBox>
    </top>

    <!-- MAIN CONTENT -->
    <center>
        <VBox alignment="CENTER" spacing="20" styleClass="album-container">

            <ImageView fx:id="coverImage"
                       fitWidth="220"
                       fitHeight="220"
                       preserveRatio="true"/>

            <Label fx:id="titleLabel" styleClass="title-label"/>
            <Label fx:id="artistLabel" styleClass="artist-label"/>
            <Label fx:id="ratingLabel" styleClass="rating-label"/>

            <Label text="Reviews coming soon..." styleClass="muted-text"/>

        </VBox>
    </center>

</BorderPane>
